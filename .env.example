# Feature Flags for API Usage Optimization
VITE_FEATURE_RAPIDAPI=false
VITE_DEBUG_FUNCTIONS=false

# Spotify Polling Configuration
VITE_SPOTIFY_POLL_INTERVAL_MS=60000
VITE_SPOTIFY_VISIBILITY_GATING=1
VITE_EXTENDED_SPOTIFY_API=0

# Existing environment variables
VITE_SPOTIFY_CLIENT_ID=your_spotify_client_id
VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key